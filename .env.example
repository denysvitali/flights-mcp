# Environment variables for flights-mcp server
# Copy this file to .env and customize as needed

# Server configuration
SERVER_NAME=flights-mcp
SERVER_VERSION=1.0.0
LOG_LEVEL=info

# Scraper settings
# Backend: "http" (default, no browser needed) or "chrome" (headless Chrome)
SCRAPER_BACKEND=http
CHROME_PATH=
HEADLESS_MODE=true
REQUEST_TIMEOUT=30s
MAX_RETRIES=3
RETRY_DELAY=2s

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60s

# Anti-bot settings
RANDOM_DELAY_MIN=1s
RANDOM_DELAY_MAX=3s
PROXY_URL=

# Airports database (empty = use the copy embedded in the binary)
AIRPORTS_FILE=
